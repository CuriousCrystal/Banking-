# Copy this file to .env (it is git-ignored) and fill it in. Never commit real values.

# MySQL: root is only used to bootstrap the container, the app connects as the "bfsi" user
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app

# base64 HMAC signing key for the login tokens, at least 32 bytes:   openssl rand -base64 48
JWT_SECRET=

# only when the UI is served from a different origin than /api (comma separated, patterns allowed)
CORS_ALLOWED_ORIGINS=

# host port the web UI is published on
HTTP_PORT=8080
